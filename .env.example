# =============================================================================
# The TOEFL House — environment template
# =============================================================================
# This file is the template for the production .env (the deployment copies
# your persistent .env — which you create from this file — into each release
# and validates APP_ENV=production / APP_DEBUG=false).
#
#   * Copy to `.env` and fill in the secret values (APP_KEY, DB credentials).
#   * Never commit the real `.env`. Only this template is versioned.
#   * Generate APP_KEY with:  php artisan key:generate
#
# The production deployment MUST run with:
#   APP_ENV=production
#   APP_DEBUG=false
# (deploy/deploy.sh enforces both and aborts the deployment otherwise.)
# =============================================================================

APP_NAME="The TOEFL House"

# --- Runtime mode (production) ---------------------------------------------
APP_ENV=production
# Debug output is disabled in production: errors are logged, never disclosed
# to clients. Set true only in a local development .env.
APP_DEBUG=false
# Required. Generate with: php artisan key:generate
APP_KEY=
# Base URL of the deployment (used for generated links).
APP_URL=https://toeflhouse.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# --- Logging ----------------------------------------------------------------
# In production, log to a file (collected by the host log aggregator) rather
# than stderr. Levels: debug|info|notice|warning|error|critical|alert|emergency.
LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Sessions (durable, database-backed) ------------------------------------
# The employee console persists sessions in the `sessions` table.
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Production is served over HTTPS (nginx terminates TLS), so the session
# cookie is sent only over secure connections. Keep true in production.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false

# --- Cache / queue ----------------------------------------------------------
# CACHE_STORE=database: the login rate limiter (brute-force protection) must
# survive across PHP-FPM workers, so it uses the persistent cache store (the
# `cache` table). Do not use the array store in production — it is per-worker
# and would defeat rate limiting.
CACHE_STORE=database
# The app is a synchronous modular monolith: no async jobs, no queue workers.
# Sync is the correct and only connection for this system.
QUEUE_CONNECTION=sync

# --- Database (PostgreSQL) --------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=toefl_house
DB_USERNAME=postgres
# Set to your database password (do not commit it).
DB_PASSWORD=
# TLS to the database: prefer|require|verify-full. Use require/verify-full if
# the database is not on the same host.
DB_SSLMODE=prefer
