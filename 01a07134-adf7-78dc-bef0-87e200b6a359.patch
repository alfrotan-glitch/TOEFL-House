+                END IF;
+                RETURN NEW;
+            END;
+            $fn$ LANGUAGE plpgsql;
+            SQL);
+        DB::statement('CREATE TRIGGER academic_canonical_teacher_class_guard_trigger BEFORE INSERT OR UPDATE ON classes FOR EACH ROW EXECUTE FUNCTION academic_canonical_teacher_class_guard()');
