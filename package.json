{
  "name": "toefl-house-erp-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts",
    "build:frontend": "npm run build",
    "build:backend": "npm --prefix server run build",
    "build:all": "npm run build:frontend && npm run build:backend",
    "lint:backend": "npm --prefix server run lint",
    "test:backend": "npm --prefix server test",
    "audit:product": "node scripts/verify-product-integrity.mjs",
    "audit:static": "node scripts/high-assurance-static-audit.mjs",
    "release:validate": "node scripts/release-validate.mjs",
    "release:validate:quick": "node scripts/release-validate.mjs --quick",
    "audit:bundle": "node scripts/verify-bundle-weight.mjs",
    "audit:registries": "node scripts/verify-registries.mjs",
    "audit:protocol": "node scripts/verify-protocol.mjs",
    "audit:design-system": "node scripts/verify-design-system.mjs",
    "audit:logging": "node scripts/verify-logging.mjs",
    "audit:cleanliness": "node scripts/verify-source-cleanliness.mjs",
    "audit:deps": "node scripts/verify-server-dependency-isolation.mjs"
  },
  "dependencies": {
    "lucide-react": "1.27.0",
    "qrcode": "^1.5.4",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.1.11",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  },
  "packageManager": "npm@10.9.2"
}
