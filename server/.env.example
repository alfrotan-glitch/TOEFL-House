# TOEFL House ERP server first-install template
# bootstrap:env replaces placeholder secrets automatically.
JWT_SECRET=change-this-to-a-long-random-secret-in-production
PORT=4000
JWT_EXPIRES_IN=12h
DB_PATH=./data/erp.sqlite
CORS_ORIGIN=http://localhost:3000
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=replace-with-a-strong-password-at-least-12-characters
SEED_OWNER_NAME=System Owner
SEED_OWNER_EMAIL=owner@example.com
