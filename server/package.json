{
  "name": "toefl-house-erp-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "seed": "tsx src/db/seed.ts",
    "lint": "eslint src scripts && tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "build": "tsc && node scripts/copy-dist-assets.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "bootstrap:env": "node scripts/ensure-first-install-env.mjs",
    "bootstrap": "npm run bootstrap:env && npm run seed",
    "preflight:fresh-schema": "node scripts/verify-canonical-schema.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "audit:config-data": "tsx scripts/config-data-integrity-audit.mjs",
    "audit:mutation": "node scripts/run-mutation-harnesses.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsdom": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.14.0",
    "@types/react": "19.1.11",
    "@types/react-dom": "19.1.7",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.27.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "nanoid": "3.3.18"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  },
  "packageManager": "npm@10.9.2"
}
