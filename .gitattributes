# Normalise line endings so a Windows checkout and a Linux/CI checkout compile
# and hash identically.
#
# Without this, git on Windows defaults to core.autocrlf=true and rewrites LF
# to CRLF in the working tree. Source stays parseable, but SQL files applied
# through better-sqlite3, snapshot/serialisation comparisons and any
# byte-sensitive check can differ between platforms — which makes a failure
# reproduce on one machine and not the other.
#
# `text=auto eol=lf` keeps LF in the repository AND in the working tree on
# every platform.
* text=auto eol=lf

# Binary assets must never be line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.sqlite binary
*.node binary

# Windows-only helper scripts genuinely need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
