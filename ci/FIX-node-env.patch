diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 48a86f6..049a836 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -9,9 +9,13 @@ concurrency:
   group: ci-${{ github.ref }}
   cancel-in-progress: true
 
+# NODE_ENV is deliberately NOT set globally. It was, and it silently broke the
+# frontend job: with NODE_ENV=test Vite skips production chunking, so the React
+# vendor chunk disappeared and first-paint weight went 482 KB -> 701 KB, failing
+# the bundle budget for a reason that had nothing to do with the code. Only the
+# backend job needs it, so it is set there.
 env:
   JWT_SECRET: ci-only-jwt-secret-not-used-in-production-0123456789
-  NODE_ENV: test
 
 jobs:
   frontend:
@@ -34,6 +38,8 @@ jobs:
   backend:
     name: Backend — typecheck, tests, schema preflight
     runs-on: ubuntu-latest
+    env:
+      NODE_ENV: test
     steps:
       - uses: actions/checkout@v4
 
